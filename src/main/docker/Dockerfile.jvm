####
# JVM image for the Quarkus app, including Playwright's headless Chromium
# (used by TjrsProcessScraper to query consulta.tjrs.jus.br).
#
# The official Playwright Java image already ships Chromium and the OS
# libraries it needs (Ubuntu Noble), but its default JDK is 21. This
# Dockerfile keeps that browser stack and installs Temurin JDK 25 on top,
# matching maven.compiler.release=25.
#
# Before building the container image run:
#
# ./mvnw package
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.jvm -t quarkus/dora-jvm .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/dora-jvm
###
FROM mcr.microsoft.com/playwright/java:v1.62.0-noble

ENV LANGUAGE='en_US:en'
ENV SDKMAN_DIR=/root/.sdkman
ENV SDKMAN_AUTO_ANSWER=true

# Playwright's image JDK is 21; install Temurin 25 via SDKMAN so the Quarkus
# app (compiled with --release 25) can run. SDKMAN picks the right artifact
# for the image architecture (amd64 / arm64) — Adoptium's "latest/ga" URL
# 404s for linux/aarch64.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates unzip zip bash; \
    curl -s "https://get.sdkman.io?rcupdate=false" | bash; \
    bash -lc "source ${SDKMAN_DIR}/bin/sdkman-init.sh && sdk install java 25-tem"; \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/root/.sdkman/candidates/java/current
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY target/quarkus-app/lib/ /deployments/lib/
COPY target/quarkus-app/*.jar /deployments/
COPY target/quarkus-app/app/ /deployments/app/
COPY target/quarkus-app/quarkus/ /deployments/quarkus/

# Base RAG documents (PDF, text, etc.) ingested on startup. In dev this is read
# straight from src/main/resources/rag (relative path); in prod it must be an
# absolute path inside the image, so we bake the same folder in here and point
# %prod.rag.location (application.properties) at it.
COPY src/main/resources/rag/ /work/rag/

EXPOSE 8080
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar"]
