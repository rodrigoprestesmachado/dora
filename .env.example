# Copy this file to .env on the EC2 instance and fill in real values.
# .env is gitignored — never commit real secrets.

# ------------------------------------------------------------------
# Public domain / TLS (Caddy requests a Let's Encrypt cert for DOMAIN)
# ------------------------------------------------------------------
# Any public hostname that resolves to this instance's IP works here — it
# does not need to be a domain you own/registered. If you don't have a
# custom domain, use one of the values from `terraform output` instead:
#   DOMAIN=<sslip_domain output>          e.g. 52-91-12-34.sslip.io
#   DOMAIN=<public_dns output>            e.g. ec2-52-91-12-34.compute-1.amazonaws.com
# See docs/aws.md ("Não quero um domínio próprio") for details.
DOMAIN=dora.example.com
ACME_EMAIL=you@example.com

# ------------------------------------------------------------------
# Postgres (chat persistence + pgvector embeddings)
# ------------------------------------------------------------------
POSTGRES_USER=dora
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------------
# WhatsApp Cloud API (optional — leave empty to disable WhatsApp integration)
# ------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dora-webhook-verify
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------
# OpenAI (required in prod)
# ------------------------------------------------------------------
# Used as the chat model (gpt-4o-mini) instead of Ollama/gemma4:e2b — see
# application.properties. Also used to transcribe WhatsApp audio via Whisper
# (optional; only needed if you enable WhatsApp audio messages above).
OPENAI_API_KEY=
